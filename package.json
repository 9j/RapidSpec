	},
	"keywords": [
		"claude-code",
		"rapidspec",
		"spec-driven",
		"workflow",
		"ai-agents",
		"checkpoint",
		"linear",
		"openspec"
	],
	"author": "BAK Chanhee <bak@chanhee.kr>",
	"license": "MIT",
	"dependencies": {
		"@linear/sdk": "^28.0.0",
		"commander": "^12.0.0",
		"chalk": "^5.3.0",
		"ora": "^8.0.1",
		"inquirer": "^10.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
