{
	"name": "rapidspec",
	"version": "0.4.3",
	"description": "Spec-driven development workflow with AI agents for Claude Code and Cursor IDE. Includes 18 specialized agents and checkpoint-based implementation.",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"rapid": "./dist/index.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/9j/RapidSpec.git"
	},
	"homepage": "https://github.com/9j/RapidSpec",
	"bugs": {
		"url": "https://github.com/9j/RapidSpec/issues"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
